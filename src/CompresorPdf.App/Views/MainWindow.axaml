<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CompresorPdf.App.ViewModels"
        xmlns:conv="using:CompresorPdf.App.Converters"
        xmlns:sc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        x:Class="CompresorPdf.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Compresor de PDFs"
        Width="980" Height="680"
        MinWidth="760" MinHeight="480"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource SemiColorBackground0}"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="44,*,Auto">

    <!-- ══ Barra de título propia (plan de diseño, sección 5.1) ══
         Idéntica en macOS y Windows: sustituye tanto los semáforos como los botones
         min/max/cerrar nativos. El arrastre y el doble-clic para maximizar se manejan a
         mano en el code-behind; el redimensionado de bordes lo sigue dando el sistema
         operativo (SystemDecorations se deja en su valor "Full" por defecto). -->
    <Border Grid.Row="0" Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1"
            PointerPressed="AlPresionarBarraTitulo">

      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                    Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="9" Height="9" CornerRadius="3" Background="{DynamicResource SemiColorPrimary}" />
          <TextBlock Text="Compresor de PDFs" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock Grid.Column="2" Text="{Binding ResumenAjustes}" VerticalAlignment="Center"
                   FontSize="12" Opacity="0.55" Margin="0,0,10,0" IsHitTestVisible="False" />

        <!-- Ajustes: conmuta el panel lateral fijo (RF-26 / ADR-008), ya no abre un Flyout. -->
        <Button Grid.Column="3" Classes="boton-ventana" Margin="0,0,2,0"
                Command="{Binding AlternarPanelConfigCommand}" ToolTip.Tip="Mostrar / ocultar configuración">
          <Path Data="{StaticResource IconoAjustes}" Width="16" Height="16" Stretch="Uniform"
                Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                StrokeLineCap="Round" />
        </Button>

        <!-- Minimizar / maximizar / cerrar: idénticos en ambos sistemas operativos. -->
        <Button Grid.Column="4" Classes="boton-ventana" Click="AlMinimizar" ToolTip.Tip="Minimizar">
          <Path Data="{StaticResource IconoMinus}" Width="14" Height="14" Stretch="Uniform"
                Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6" StrokeLineCap="Round" />
        </Button>
        <Button Grid.Column="5" Classes="boton-ventana" Click="AlMaximizar" x:Name="BotonMaximizar"
                ToolTip.Tip="Maximizar">
          <Path x:Name="IconoMaximizarVentana" Data="{StaticResource IconoMaximizar}"
                Width="12" Height="12" Stretch="Uniform"
                Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round" />
        </Button>
        <Button Grid.Column="6" Classes="boton-ventana cerrar" Margin="0,0,4,0" Click="AlCerrar"
                ToolTip.Tip="Cerrar">
          <Path Data="{StaticResource IconoCancelado}" Width="13" Height="13" Stretch="Uniform"
                Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" />
        </Button>

      </Grid>
    </Border>

    <!-- ══ Contenido + panel de configuración lateral (RF-26 / ADR-008) ══ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Margin="20,16,20,16">

      <!-- Aviso del motor: sólo estorba si de verdad falta algo que hacer. -->
      <Border Grid.Row="0" IsVisible="{Binding !GhostscriptDisponible}"
              Background="{DynamicResource SemiColorWarningLight}" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,12">
        <TextBlock Text="{Binding AvisoMotor}" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource SemiColorWarning}" />
      </Border>

      <!-- Cabecera de la lista (RF-22/23): visible sólo cuando hay archivos y no se está
           procesando — HayArchivos ya implica ambas condiciones. -->
      <Grid Grid.Row="1" ColumnDefinitions="42,*,Auto"
            IsVisible="{Binding HayArchivos}"
            Margin="14,0,14,4">
        <CheckBox Grid.Column="0" IsChecked="{Binding TodosSeleccionados}"
                  VerticalAlignment="Center" ToolTip.Tip="Seleccionar / deseleccionar todo" />
        <TextBlock Grid.Column="1" Text="Archivo" FontSize="11.5" Opacity="0.45"
                   VerticalAlignment="Center" />
        <!-- RF-23: quitar sólo los seleccionados sin limpiar el lote completo -->
        <Button Grid.Column="2" Command="{Binding QuitarSeleccionadosCommand}"
                IsVisible="{Binding HaySeleccionados}"
                Padding="8,4" FontSize="12">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconoPapelera}" Width="11" Height="11" Stretch="Uniform"
                  Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.5"
                  StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="Quitar seleccionados" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Zona de carga / lista de archivos: un único contenedor con feedback de
           arrastre (sección 5.2 y 5.3). -->
      <Border Grid.Row="2" x:Name="ZonaPrincipal" Classes="zona-carga">
        <Panel>

          <Button Classes="zona-carga-boton" IsVisible="{Binding !Filas.Count}"
                  IsEnabled="{Binding PuedeAnadirArchivos}" Click="AlAnadirArchivos">
            <Panel>

              <!-- Estado vacío normal. -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                          IsVisible="{Binding !Analizando}">
                <Path Data="{StaticResource IconoSubir}" Width="46" Height="46" Stretch="Uniform"
                      Stroke="{DynamicResource SemiColorText3}" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" />
                <StackPanel Spacing="3">
                  <TextBlock Text="Arrastra tus PDFs aquí" FontSize="15" FontWeight="Medium"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="o pulsa para elegir archivos" FontSize="12.5" Opacity="0.55"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <!-- Analizando un lote grande (RF-19): antes esto congelaba la ventana sin
                   avisar nada; ahora corre fuera del hilo de UI y se ve. -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                          IsVisible="{Binding Analizando}">
                <Path Data="{StaticResource IconoEspiral}" Width="34" Height="34" Stretch="Uniform"
                      Classes="acento girando" StrokeThickness="1.6"
                      StrokeLineCap="Round" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding MensajeEstado}" FontSize="13" FontWeight="Medium"
                           Opacity="0.75" HorizontalAlignment="Center" />
              </StackPanel>

            </Panel>
          </Button>

          <!-- RF-22: columna 0 (28 px) = checkbox de selección; columna 1 = ícono de estado;
               columnas 2-4 = datos del archivo.
               El ItemsControl no scrollea por sí solo (a diferencia de un ListBox): con lotes
               de cientos de PDFs hay que envolverlo en un ScrollViewer o las últimas filas
               quedan fuera de la ventana. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Filas}" IsVisible="{Binding Filas.Count}" Padding="6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilaResultadoViewModel">
                <Border Classes="fila-archivo" Padding="10,10" CornerRadius="8">
                  <Grid ColumnDefinitions="28,22,*,Auto,Auto" ColumnSpacing="10">

                    <CheckBox Grid.Column="0" IsChecked="{Binding Seleccionada}"
                              VerticalAlignment="Center" />

                    <Path Grid.Column="1" Width="16" Height="16" Stretch="Uniform"
                          VerticalAlignment="Center" IsVisible="{Binding TieneIcono}"
                          Data="{Binding IconoClave, Converter={x:Static conv:ConvertidorClaveAIcono.Instancia}}"
                          StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                          Classes.girando="{Binding EsAcento}"
                          Classes.exito="{Binding EsExito}" Classes.neutral="{Binding EsNeutral}"
                          Classes.aviso="{Binding EsAviso}" Classes.peligro="{Binding EsPeligro}"
                          Classes.acento="{Binding EsAcento}" />

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Mensaje}" FontSize="11" Opacity="0.55"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Mensaje, Converter={x:Static sc:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12.5"
                               FontFamily="Consolas,Menlo,monospace" Opacity="0.7">
                      <Run Text="{Binding TamanoOriginal}" /><Run Text=" → " /><Run Text="{Binding TamanoFinal}" />
                    </TextBlock>

                    <Border Grid.Column="4" Classes="chip exito" VerticalAlignment="Center"
                            IsVisible="{Binding Reduccion, Converter={x:Static sc:StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Reduccion}" />
                    </Border>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>

        </Panel>
      </Border>

      <!-- Progreso: comprimiendo o analizando (RF-19) comparten la misma barra. -->
      <StackPanel Grid.Row="3" Spacing="6" Margin="0,14,0,0" IsVisible="{Binding EstaOcupado}">
        <ProgressBar Value="{Binding Progreso}" Maximum="100" Height="6" CornerRadius="3" />
        <!-- RF-21: totales acumulados en vivo — aparecen en cuanto hay al menos un
             archivo comprimido, así el usuario ve el ahorro crecer fila a fila. -->
        <Border IsVisible="{Binding HayTotalesEnVivo}"
                Background="{DynamicResource SemiColorFill0}"
                CornerRadius="6" Padding="12,7">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" FontSize="12" FontFamily="Consolas,Menlo,monospace">
              <Run Text="{Binding TotalOriginalEnVivo}" />
              <Run Text=" → " />
              <Run Text="{Binding TotalFinalEnVivo}" />
              <Run Text=" · " />
              <Run Text="{Binding TotalAhorroEnVivo}" Foreground="{DynamicResource SemiColorSuccess}" />
              <Run Text=" ahorrados" />
            </TextBlock>
            <Border Grid.Column="1" Classes="chip exito" VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalAhorroPorcentajeEnVivo}" />
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Opacity="0.6" />
      </StackPanel>

      <!-- Resumen destacado (sección 5.6): el ahorro total es el dato que importa. -->
      <Border Grid.Row="3" Margin="0,14,0,0" Padding="18,15" CornerRadius="10"
              Background="{DynamicResource SemiColorFill0}"
              IsVisible="{Binding HayResumen}">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding AhorroDestacado}" FontSize="27" FontWeight="Bold"
                       Foreground="{DynamicResource SemiColorPrimary}" />
            <TextBlock Text="ahorrados" FontSize="11" Opacity="0.55" />
          </StackPanel>
          <TextBlock Text="{Binding AhorroPorcentaje}" FontSize="19" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource SemiColorSuccess}"
                     IsVisible="{Binding AhorroPorcentaje, Converter={x:Static sc:StringConverters.IsNotNullOrEmpty}}" />
          <Border Width="1" VerticalAlignment="Stretch" Margin="2,0"
                  Background="{DynamicResource SemiColorBorder}" />
          <TextBlock Text="{Binding DetalleResumen}" VerticalAlignment="Center" FontSize="12.5"
                     Opacity="0.75" TextWrapping="Wrap" MaxWidth="360" />
        </StackPanel>
      </Border>

    </Grid>

    <!-- ══ Panel de configuración lateral (RF-26 / ADR-008) ══
         Sustituye al antiguo Flyout: siempre presente, plegable con el botón de engranaje de
         la barra de título. Su estado (plegado o no) se persiste en PreferenciasUsuario. -->
    <Border Grid.Column="1" Classes="panel-config" Width="300"
            IsVisible="{Binding PanelConfigVisible}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="18">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Configuración" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="boton-ventana"
                    Command="{Binding AlternarPanelConfigCommand}" ToolTip.Tip="Plegar panel">
              <Path Data="{StaticResource IconoPlegar}" Width="14" Height="14" Stretch="Uniform"
                    Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
          </Grid>

          <!-- ─── Compresión ─── -->
          <StackPanel Spacing="13">
            <TextBlock Text="COMPRESIÓN" FontSize="10.5" FontWeight="SemiBold" Opacity="0.5" />

            <StackPanel Spacing="6">
              <TextBlock Text="Comprimir si supera" FontSize="12" Opacity="0.65" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <NumericUpDown Value="{Binding UmbralValor}" Minimum="0"
                               Maximum="{Binding UmbralMaximo}"
                               Increment="{Binding UmbralIncremento}"
                               FormatString="{Binding UmbralFormato}" Width="118" />
                <!-- Unidad del umbral (RF-25): cambiarla no cambia el umbral efectivo,
                     sólo cómo se edita — ver MainWindowViewModel.UmbralValor. -->
                <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="8" Padding="3">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton Classes="segmento" Content="KB" Padding="10,5"
                                  IsChecked="{Binding UnidadUmbral, Converter={x:Static conv:ConvertidorEnumIgual.Instancia}, ConverterParameter=KB}" />
                    <ToggleButton Classes="segmento" Content="MB" Padding="10,5"
                                  IsChecked="{Binding UnidadUmbral, Converter={x:Static conv:ConvertidorEnumIgual.Instancia}, ConverterParameter=MB}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="Nivel de compresión" FontSize="12" Opacity="0.65" />
              <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <ToggleButton Classes="segmento" Content="Bajo" HorizontalAlignment="Stretch"
                                IsChecked="{Binding Nivel, Converter={x:Static conv:ConvertidorEnumIgual.Instancia}, ConverterParameter=Bajo}" />
                  <ToggleButton Classes="segmento" Content="Medio" HorizontalAlignment="Stretch"
                                IsChecked="{Binding Nivel, Converter={x:Static conv:ConvertidorEnumIgual.Instancia}, ConverterParameter=Medio}" />
                  <ToggleButton Classes="segmento" Content="Alto" HorizontalAlignment="Stretch"
                                IsChecked="{Binding Nivel, Converter={x:Static conv:ConvertidorEnumIgual.Instancia}, ConverterParameter=Alto}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- RF-28 -->
            <StackPanel Spacing="2">
              <CheckBox Content="Convertir a escala de grises" IsChecked="{Binding EscalaDeGrises}" />
              <TextBlock Text="Reduce mucho, elimina el color." FontSize="11" Opacity="0.5"
                         Margin="24,0,0,0" />
            </StackPanel>
          </StackPanel>

          <Separator />

          <!-- ─── Salida ─── -->
          <StackPanel Spacing="13">
            <TextBlock Text="SALIDA" FontSize="10.5" FontWeight="SemiBold" Opacity="0.5" />

            <CheckBox Content="Guardar junto al original (comprimidos/)"
                      IsChecked="{Binding SalidaJuntoAlOriginal}" />

            <StackPanel Spacing="8" IsVisible="{Binding !SalidaJuntoAlOriginal}">
              <TextBox Text="{Binding CarpetaSalida}" Watermark="Carpeta de salida" />
              <Button Click="AlElegirCarpeta" HorizontalAlignment="Left" FontSize="12" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconoCarpeta}" Width="13" Height="13" Stretch="Uniform"
                        Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                        StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Text="Elegir carpeta" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- RF-29: el campo ya se persistía; ahora es editable. -->
            <StackPanel Spacing="6">
              <TextBlock Text="Sufijo del nombre" FontSize="12" Opacity="0.65" />
              <TextBox Text="{Binding SufijoSalida}" Watermark="(ninguno)" Width="150"
                       HorizontalAlignment="Left" />
              <TextBlock Text="{Binding EjemploNombreSalida}" FontSize="11" Opacity="0.5"
                         FontFamily="Consolas,Menlo,monospace" />
            </StackPanel>
          </StackPanel>

          <Separator />

          <!-- ─── Motor ─── -->
          <StackPanel Spacing="13">
            <TextBlock Text="MOTOR" FontSize="10.5" FontWeight="SemiBold" Opacity="0.5" />

            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{Binding GhostscriptDisponible, Converter={x:Static conv:ConvertidorDisponibleAColor.Instancia}}" />
              <TextBlock Text="{Binding AvisoMotor}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>

            <!-- RF-30: la ruta manual de Ghostscript y "volver a comprobar" están ocultas por
                 ahora (el ViewModel y el code-behind conservan la lógica: AlElegirGhostscript,
                 VolverAComprobarMotorCommand). -->

            <!-- RF-31 -->
            <StackPanel Spacing="6">
              <TextBlock Text="Archivos en paralelo" FontSize="12" Opacity="0.65" />
              <NumericUpDown Value="{Binding ParalelismoValor}" Minimum="1"
                             Maximum="{Binding MaxParalelismo}" Increment="1" FormatString="0"
                             Width="104" HorizontalAlignment="Left" />
              <TextBlock Text="Más a la vez: más rápido, más CPU y memoria." FontSize="11"
                         Opacity="0.5" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Carril para volver a mostrar el panel cuando está plegado (RF-26). Ocupa la misma
         columna Auto que el panel; sólo uno de los dos es visible a la vez. -->
    <Border Grid.Column="1" Classes="panel-config" Width="40"
            IsVisible="{Binding !PanelConfigVisible}">
      <Button Classes="boton-ventana" VerticalAlignment="Top" Margin="0,10,0,0"
              Command="{Binding AlternarPanelConfigCommand}" ToolTip.Tip="Mostrar configuración">
        <Path Data="{StaticResource IconoDesplegar}" Width="14" Height="14" Stretch="Uniform"
              Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
              StrokeLineCap="Round" StrokeJoin="Round" />
      </Button>
    </Border>

    </Grid>

    <!-- ══ Footer de acciones (ancho completo, bajo el contenido y el panel) ══
         Antes vivía dentro de la columna del contenido y, con el panel de 300 px abierto,
         los botones quedaban montados con el panel. Aquí ocupa todo el ancho de la ventana
         y, si aún no cabe, los botones bajan de línea (WrapPanel) en vez de solaparse. -->
    <Border Grid.Row="2" Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

        <!-- RF-33: total antes/después de los comprimidos. -->
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                   FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HayDescarga}" Text="{Binding ResumenDescarga}" />

        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                   ItemSpacing="10" LineSpacing="8">

          <!-- RF-33: reunir todos los comprimidos en la carpeta de salida configurada. -->
          <Button Command="{Binding DescargarComprimidosCommand}" IsVisible="{Binding HayDescarga}"
                  ToolTip.Tip="Copiar todos los comprimidos a la carpeta de salida">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconoSubir}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="Descargar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- RF-24: abrir en el explorador del SO la carpeta con los comprimidos. -->
          <Button Command="{Binding AbrirCarpetaResultadosCommand}" IsVisible="{Binding HayResumen}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconoCarpeta}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="Abrir carpeta" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="AlAnadirArchivos" IsEnabled="{Binding PuedeAnadirArchivos}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconoMas}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.8" StrokeLineCap="Round" />
              <TextBlock Text="Añadir archivos" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding LimpiarCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconoPapelera}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="Limpiar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Reintentar sólo los archivos que fallaron por el motor (no corruptos/protegidos). -->
          <Button Command="{Binding ReintentarFallidosCommand}" IsVisible="{Binding HayFallidos}"
                  ToolTip.Tip="Volver a intentar sólo los archivos con error">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconoEspiral}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource SemiColorText1}" StrokeThickness="1.6"
                    StrokeLineCap="Round" />
              <TextBlock Text="Reintentar fallidos" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- "Cancelar" sólo tiene sentido durante un proceso en curso. -->
          <Button Command="{Binding CancelarCommand}" Content="Cancelar"
                  IsVisible="{Binding Procesando}" />
          <Button Command="{Binding ComprimirCommand}" Classes="Primary" Content="Comprimir"
                  MinWidth="120" />
        </WrapPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
