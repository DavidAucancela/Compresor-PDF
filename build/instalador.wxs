<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalador MSI para Windows (RNF-04). Se construye con WiX v7:
      dotnet tool install -g wix
      wix build instalador.wxs -d PublishDir=... -o CompresorPdf.msi

  NOTA LEGAL: este paquete no incluye Ghostscript y no debe incluirlo (ADR-003, AGPL).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Compresor de PDFs"
           Manufacturer="David Aucancela"
           Version="$(var.Version)"
           UpgradeCode="C3A6BAB0-3BBB-41C5-BC54-B8BC3CFF8242"
           Scope="perMachine"
           Language="3082">

    <SummaryInformation Description="Compresor de PDFs por lotes" />

    <MajorUpgrade DowngradeErrorMessage="Ya hay instalada una versión más reciente de [ProductName]." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Todo el contenido de la publicación self-contained. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Compresor de PDFs" />
    </StandardDirectory>

    <ComponentGroup Id="ArchivosApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Acceso directo en el menú Inicio. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AccesoDirectoInicio" Guid="01826629-56B8-46E2-9659-C675BABA7168">
        <Shortcut Id="AtajoMenuInicio"
                  Name="Compresor de PDFs"
                  Description="Comprime PDFs por lotes"
                  Target="[INSTALLFOLDER]CompresorPdf.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="IconoApp" />
        <RegistryValue Root="HKCU"
                       Key="Software\DavidAucancela\CompresorPdf"
                       Name="instalado" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="IconoApp" SourceFile="build/CompresorPdf.ico" />
    <Property Id="ARPPRODUCTICON" Value="IconoApp" />
    <Property Id="ARPHELPLINK" Value="https://github.com/DavidAucancela" />

    <Feature Id="Principal" Title="Compresor de PDFs" Level="1">
      <ComponentGroupRef Id="ArchivosApp" />
      <ComponentRef Id="AccesoDirectoInicio" />
    </Feature>

    <ui:WixUI xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="build/licencia.rtf" />

  </Package>
</Wix>
